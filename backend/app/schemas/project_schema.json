{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "AIVideoProject",
  "description": "Schema definition for an AI Video Studio documentary project",
  "type": "object",
  "required": ["id", "title", "aspect_ratio", "created_at", "updated_at", "storyboard"],
  "properties": {
    "id": {
      "type": "string",
      "description": "Unique identifier for the project (slug or uuid)"
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "description": "Human-readable project title"
    },
    "description": {
      "type": "string",
      "description": "Documentary synopsis or summary"
    },
    "aspect_ratio": {
      "type": "string",
      "enum": ["9:16", "16:9"],
      "default": "9:16"
    },
    "resolution": {
      "type": "object",
      "required": ["width", "height"],
      "properties": {
        "width": { "type": "integer", "default": 1080 },
        "height": { "type": "integer", "default": 1920 }
      }
    },
    "fps": {
      "type": "number",
      "enum": [24, 30, 60],
      "default": 30
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "updated_at": {
      "type": "string",
      "format": "date-time"
    },
    "settings": {
      "type": "object",
      "properties": {
        "voice": {
          "type": "string",
          "default": "id-ID-ArdiNeural"
        },
        "bgm_volume": {
          "type": "number",
          "minimum": 0.0,
          "maximum": 1.0,
          "default": 0.15
        },
        "ducking_volume": {
          "type": "number",
          "minimum": 0.0,
          "maximum": 1.0,
          "default": 0.04
        },
        "motion_graphics_style": {
          "type": "string",
          "enum": ["documentary_modern", "cinematic_noir", "minimalist_bold"],
          "default": "documentary_modern"
        }
      }
    },
    "storyboard": {
      "$ref": "storyboard_schema.json"
    }
  }
}
