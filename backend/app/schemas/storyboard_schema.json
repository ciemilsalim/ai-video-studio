{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Storyboard",
  "description": "Structured sequence of scenes, shots, prompts, narration, and overlays",
  "type": "object",
  "required": ["version", "scenes"],
  "properties": {
    "version": {
      "type": "string",
      "default": "1.0.0"
    },
    "total_estimated_duration_sec": {
      "type": "number",
      "minimum": 0
    },
    "scenes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["scene_id", "scene_number", "title", "shots"],
        "properties": {
          "scene_id": {
            "type": "string"
          },
          "scene_number": {
            "type": "integer",
            "minimum": 1
          },
          "title": {
            "type": "string"
          },
          "narration_text": {
            "type": "string",
            "description": "Voice-over text for this scene"
          },
          "shots": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["shot_id", "shot_type", "visual_prompt", "duration_sec"],
              "properties": {
                "shot_id": { "type": "string" },
                "shot_type": {
                  "type": "string",
                  "enum": [
                    "close_up",
                    "medium_shot",
                    "wide_angle",
                    "drone_aerial",
                    "macro_detail",
                    "pov"
                  ]
                },
                "camera_movement": {
                  "type": "string",
                  "enum": [
                    "static",
                    "slow_push_in",
                    "slow_pull_back",
                    "pan_left",
                    "pan_right",
                    "tracking_shot",
                    "orbit_360"
                  ],
                  "default": "slow_push_in"
                },
                "visual_prompt": {
                  "type": "string",
                  "description": "High-fidelity descriptive prompt for Google Flow"
                },
                "flow_parameters": {
                  "type": "object",
                  "properties": {
                    "lighting": { "type": "string", "default": "cinematic dramatic lighting" },
                    "lens": { "type": "string", "default": "35mm anamorphic" },
                    "aspect_ratio": { "type": "string", "default": "9:16" },
                    "negative_prompt": { "type": "string", "default": "low quality, cartoon, blurry, distorted" }
                  }
                },
                "duration_sec": {
                  "type": "number",
                  "minimum": 1.0,
                  "maximum": 60.0,
                  "default": 4.0
                },
                "motion_graphic": {
                  "type": "object",
                  "properties": {
                    "type": {
                      "type": "string",
                      "enum": ["none", "titlecard", "lower_third", "quote_box", "statistic_callout"],
                      "default": "none"
                    },
                    "headline": { "type": "string" },
                    "subtext": { "type": "string" }
                  }
                },
                "asset_path": {
                  "type": ["string", "null"],
                  "description": "Path to local ingested video clip file if already generated"
                }
              }
            }
          }
        }
      }
    }
  }
}
